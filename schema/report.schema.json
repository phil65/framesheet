{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/phil65/framesheet/schema/report.schema.json",
  "$defs": {
    "ActivitySample": {
      "description": "One dense video sample: share of pixels changed since the previous sample.",
      "properties": {
        "t": {
          "title": "T",
          "type": "number"
        },
        "changed_ratio": {
          "title": "Changed Ratio",
          "type": "number"
        }
      },
      "required": [
        "t",
        "changed_ratio"
      ],
      "title": "ActivitySample",
      "type": "object",
      "additionalProperties": false
    },
    "AnimationTiming": {
      "description": "Timing of one declarative animation, as reported by the browser.",
      "properties": {
        "kind": {
          "enum": [
            "smil",
            "css-animation",
            "css-transition",
            "web-animation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "duration": {
          "title": "Duration",
          "type": "number"
        },
        "iterations": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Iterations"
        },
        "direction": {
          "default": "normal",
          "title": "Direction",
          "type": "string"
        },
        "period": {
          "title": "Period",
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "End"
        },
        "transform_box": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transform Box"
        }
      },
      "required": [
        "kind",
        "target",
        "name",
        "start",
        "duration",
        "iterations",
        "direction",
        "period",
        "end",
        "transform_box"
      ],
      "title": "AnimationTiming",
      "type": "object",
      "additionalProperties": false
    },
    "DurationInfo": {
      "description": "The sampled time span and how it was chosen.",
      "properties": {
        "seconds": {
          "title": "Seconds",
          "type": "number"
        },
        "method": {
          "enum": [
            "override",
            "detected",
            "fallback",
            "media"
          ],
          "title": "Method",
          "type": "string"
        },
        "looping": {
          "title": "Looping",
          "type": "boolean"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "animations": {
          "items": {
            "$ref": "#/$defs/AnimationTiming"
          },
          "title": "Animations",
          "type": "array"
        }
      },
      "required": [
        "seconds",
        "method",
        "looping",
        "detail",
        "animations"
      ],
      "title": "DurationInfo",
      "type": "object",
      "additionalProperties": false
    },
    "ElementTrack": {
      "description": "Geometry of one animated element over all frames.",
      "properties": {
        "element": {
          "title": "Element",
          "type": "string"
        },
        "animated_by": {
          "items": {
            "type": "string"
          },
          "title": "Animated By",
          "type": "array"
        },
        "units": {
          "enum": [
            "viewBox",
            "px"
          ],
          "title": "Units",
          "type": "string"
        },
        "boxes": {
          "items": {
            "anyOf": [
              {
                "maxItems": 4,
                "minItems": 4,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Boxes",
          "type": "array"
        }
      },
      "required": [
        "element",
        "animated_by",
        "units",
        "boxes"
      ],
      "title": "ElementTrack",
      "type": "object",
      "additionalProperties": false
    },
    "Finding": {
      "description": "A single problem (or noteworthy fact) found by a static or render check.",
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string",
          "enum": [
            "malformed-xml",
            "not-svg",
            "missing-xmlns",
            "missing-viewbox",
            "missing-title",
            "script",
            "foreign-object",
            "event-handler",
            "external-url",
            "positive-begin",
            "duplicate-id",
            "broken-ref",
            "css-external",
            "no-reduced-motion",
            "transform-origin-without-box",
            "transform-without-box",
            "large-file",
            "parked-at-origin",
            "outside-bounds",
            "text-overflow",
            "svg-transform-box",
            "non-seamless-loop",
            "js-driven-motion",
            "no-visible-motion",
            "no-motion",
            "console-error",
            "video-static-stretch",
            "video-black-frames",
            "video-blank-frames",
            "video-abrupt-cut",
            "video-mark-overlap"
          ]
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "check": {
          "enum": [
            "static",
            "render"
          ],
          "title": "Check",
          "type": "string"
        },
        "element": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element"
        },
        "times": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Times"
        }
      },
      "required": [
        "severity",
        "code",
        "message",
        "check",
        "element",
        "times"
      ],
      "title": "Finding",
      "type": "object",
      "additionalProperties": false
    },
    "FrameMetrics": {
      "description": "Per-frame numbers.",
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "t": {
          "title": "T",
          "type": "number"
        },
        "changed_ratio": {
          "title": "Changed Ratio",
          "type": "number"
        },
        "changed_box": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Changed Box"
        },
        "path": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "index",
        "t",
        "changed_ratio",
        "changed_box",
        "path"
      ],
      "title": "FrameMetrics",
      "type": "object",
      "additionalProperties": false
    },
    "Images": {
      "properties": {
        "full": {
          "format": "path",
          "title": "Full",
          "type": "string"
        },
        "sheet": {
          "format": "path",
          "title": "Sheet",
          "type": "string"
        },
        "heatmap": {
          "format": "path",
          "title": "Heatmap",
          "type": "string"
        },
        "report": {
          "format": "path",
          "title": "Report",
          "type": "string"
        }
      },
      "required": [
        "full",
        "sheet",
        "heatmap",
        "report"
      ],
      "title": "Images",
      "type": "object",
      "additionalProperties": false
    },
    "LoopInfo": {
      "description": "How cleanly the last frame of a cycle joins the first.",
      "properties": {
        "checked": {
          "title": "Checked",
          "type": "boolean"
        },
        "seamless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seamless"
        },
        "seam_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seam Ratio"
        },
        "step_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Ratio"
        },
        "seam_box": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seam Box"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "checked",
        "seamless",
        "seam_ratio",
        "step_ratio",
        "seam_box",
        "detail"
      ],
      "title": "LoopInfo",
      "type": "object",
      "additionalProperties": false
    },
    "MarkFrame": {
      "additionalProperties": false,
      "description": "Pixel size the coordinates refer to (omit for normalized 0-1 coordinates).",
      "properties": {
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "MarkFrame",
      "type": "object"
    },
    "MarkPoint": {
      "additionalProperties": false,
      "description": "An instant at a position, e.g. a click: drawn on the tile nearest to ``t``.",
      "properties": {
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "duration": {
          "default": 0.0,
          "minimum": 0,
          "title": "Duration",
          "type": "number"
        }
      },
      "required": [
        "t",
        "x",
        "y",
        "label",
        "kind",
        "duration"
      ],
      "title": "MarkPoint",
      "type": "object"
    },
    "MarkRegion": {
      "additionalProperties": false,
      "description": "A time range, optionally with a box: a target element, a zoom, a highlight.",
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "w": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "W"
        },
        "h": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "H"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h",
        "start",
        "end",
        "label",
        "kind"
      ],
      "title": "MarkRegion",
      "type": "object"
    },
    "MarkSpan": {
      "additionalProperties": false,
      "description": "A labelled time range, e.g. a caption; the optional box is its screen area.",
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "w": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "W"
        },
        "h": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "H"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h",
        "start",
        "end",
        "label",
        "kind"
      ],
      "title": "MarkSpan",
      "type": "object"
    },
    "Marks": {
      "additionalProperties": false,
      "description": "Annotations drawn onto video tiles and the timeline (``--marks marks.json``).\n\nTimes are seconds of the media; coordinates are fractions (0-1) of the video frame,\nor pixels of ``frame`` if given.",
      "properties": {
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarkFrame"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "points": {
          "items": {
            "$ref": "#/$defs/MarkPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/MarkRegion"
          },
          "title": "Regions",
          "type": "array"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/MarkSpan"
          },
          "title": "Spans",
          "type": "array"
        }
      },
      "title": "Marks",
      "type": "object",
      "required": [
        "frame",
        "points",
        "regions",
        "spans"
      ]
    },
    "VideoInfo": {
      "description": "Media facts and dense-sample metrics of a video or animated image.",
      "properties": {
        "container": {
          "title": "Container",
          "type": "string"
        },
        "codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Codec"
        },
        "decoder": {
          "enum": [
            "video",
            "image-decoder"
          ],
          "title": "Decoder",
          "type": "string"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "media_duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Media Duration"
        },
        "fps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fps"
        },
        "frame_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Frame Count"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "static_threshold": {
          "title": "Static Threshold",
          "type": "number"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/ActivitySample"
          },
          "title": "Samples",
          "type": "array"
        },
        "tiles": {
          "items": {
            "$ref": "#/$defs/VideoTile"
          },
          "title": "Tiles",
          "type": "array"
        }
      },
      "required": [
        "container",
        "codec",
        "decoder",
        "width",
        "height",
        "media_duration",
        "fps",
        "frame_count",
        "start",
        "end",
        "static_threshold",
        "samples",
        "tiles"
      ],
      "title": "VideoInfo",
      "type": "object",
      "additionalProperties": false
    },
    "VideoTile": {
      "description": "Per-tile numbers for videos, so an agent can score without looking.",
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "t": {
          "title": "T",
          "type": "number"
        },
        "media_time": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Media Time"
        },
        "black": {
          "title": "Black",
          "type": "boolean"
        },
        "blank": {
          "title": "Blank",
          "type": "boolean"
        },
        "duplicate": {
          "title": "Duplicate",
          "type": "boolean"
        },
        "sharpness": {
          "title": "Sharpness",
          "type": "number"
        },
        "marks": {
          "items": {
            "type": "string"
          },
          "title": "Marks",
          "type": "array"
        }
      },
      "required": [
        "index",
        "t",
        "media_time",
        "black",
        "blank",
        "duplicate",
        "sharpness",
        "marks"
      ],
      "title": "VideoTile",
      "type": "object",
      "additionalProperties": false
    }
  },
  "description": "Everything framesheet found out about one input.",
  "properties": {
    "source": {
      "title": "Source",
      "type": "string"
    },
    "kind": {
      "enum": [
        "svg",
        "html",
        "video"
      ],
      "title": "Kind",
      "type": "string"
    },
    "viewport": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Viewport",
      "type": "array"
    },
    "device_scale_factor": {
      "title": "Device Scale Factor",
      "type": "number"
    },
    "canvas": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Canvas",
      "type": "array"
    },
    "duration": {
      "$ref": "#/$defs/DurationInfo"
    },
    "times": {
      "items": {
        "type": "number"
      },
      "title": "Times",
      "type": "array"
    },
    "full_at": {
      "title": "Full At",
      "type": "number"
    },
    "images": {
      "$ref": "#/$defs/Images"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/FrameMetrics"
      },
      "title": "Frames",
      "type": "array"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/ElementTrack"
      },
      "title": "Elements",
      "type": "array"
    },
    "loop": {
      "$ref": "#/$defs/LoopInfo"
    },
    "console_errors": {
      "items": {
        "type": "string"
      },
      "title": "Console Errors",
      "type": "array"
    },
    "video": {
      "anyOf": [
        {
          "$ref": "#/$defs/VideoInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "marks": {
      "anyOf": [
        {
          "$ref": "#/$defs/Marks"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "source",
    "kind",
    "viewport",
    "device_scale_factor",
    "canvas",
    "duration",
    "times",
    "full_at",
    "images",
    "findings",
    "frames",
